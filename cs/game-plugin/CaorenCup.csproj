<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CaorenCupFunCommands</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Archive\**" />
    <EmbeddedResource Remove="Archive\**" />
    <None Remove="Archive\**" />
    <Compile Remove="Features\ParticleMenu\**" />
    <EmbeddedResource Remove="Features\ParticleMenu\**" />
    <None Remove="Features\ParticleMenu\**" />
    <Compile Remove="Diagnostics\**" />
    <EmbeddedResource Remove="Diagnostics\**" />
    <None Remove="Diagnostics\**" />
    <Compile Remove="PluginSplit\**" />
    <EmbeddedResource Remove="PluginSplit\**" />
    <None Remove="PluginSplit\**" />
    <Compile Remove="CaorenCupConfig.cs" />
    <Compile Remove="Features\ManagedCvarScope.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />
    <ProjectReference Include="PluginSplit\CaorenCupContracts\CaorenCupContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="module-configs\presets.grass.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
