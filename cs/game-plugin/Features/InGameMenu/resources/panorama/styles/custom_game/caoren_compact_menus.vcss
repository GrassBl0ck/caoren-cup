/* A compact dialog. Its outer root remains screen-sized for alignment only. */
.CaorenSettings { horizontal-align: center; vertical-align: center; width: 790px; max-width: 94%; height: fit-children; max-height: 84%; }
.CaorenSettings.WideMenu { width: 970px; }
.CaorenSettings.CompactDetail { width: 730px; }
.CaorenSettings .CaorenMenuBody { width: 100%; height: fit-children; }
.CaorenSettings .CaorenPrimaryNav { width: 100%; height: 48px; }
.CaorenSettings .CaorenNavHost { width: 85px; height: 44px; }
.CaorenSettings .CaorenBackHost { width: 72px; height: 38px; margin: 4px 8px; }
.CaorenSettings .CaorenExitHost { width: 40px; height: 38px; margin: 4px 8px; }
.CaorenSettings .CaorenExitButton .CaorenExitGlyph { font-size: 28px; }
.CaorenSettings .CaorenBackContent .CaorenBackText { font-size: 16px; }
.CaorenSettings .CaorenSecondaryNav { width: 100%; height: 30px; }
.CaorenSettings .CaorenSettingsPage { width: 100%; height: fit-children; max-height: 620px; overflow: squish scroll; }
.CaorenSettings .CaorenSettingsContent { width: 100%; height: fit-children; margin: 0px; padding: 12px 16px; }
.CaorenSettings .CaorenMenuSection { width: 100%; height: fit-children; }
.CaorenSettings .CaorenSettingsRow { height: 52px; }
.CaorenSettings .CaorenPreferencesRow { height: 60px; }
.CaorenSettings .CaorenGuideHost, .CaorenSettings .CaorenGuideItem { height: 42px; }
.CaorenSettings .CaorenGuidePage { margin: 4px 0px; }
.CaorenSettings .CaorenBottomBrand { visibility: collapse; }
.CaorenSettings .CaorenRandomList { width: 100%; height: 324px; }
.CaorenSettings .CaorenRandomCardHost { width: 32%; height: 100%; margin-right: 2%; }
.CaorenSettings #random_buy_2_host { margin-right: 0px; }
.CaorenSettings .CaorenRandomCard { padding: 8px 12px; }
.CaorenSettings .CardGlyph { horizontal-align: center; width: 40px; height: 40px; }
.CaorenSettings .CaorenRandomCard .CaorenRandomCardName { height: fit-children; min-height: 29px; margin-top: 0px; }
.CaorenSettings .CaorenRandomOverview, .CaorenSettings .CaorenRandomDetail { min-height: 0px; height: fit-children; padding: 8px; }
.CaorenSettings .CaorenRandomDescription { height: fit-children; margin: 0px; }
.CaorenSettings .CaorenRandomCountRow { height: 38px; }
.CaorenSettings .CaorenRandomOverviewColumns { margin-top: 4px; }
.CaorenSettings .CaorenRandomFooterGroup, .CaorenSettings .CaorenRandomCollectionNav .CaorenRandomActionHost { width: 24%; margin-right: 1%; }
.CaorenSettings .CaorenSettingsRow { min-height: 52px; }
.CaorenSettings .EditorHost { width: fit-children; height: fit-children; margin: 0px 4px 0px 0px; horizontal-align: left; }
.EditorHost .CaorenHoverHint.HintBelow { position: 0px 33px 0px; }
.EditorTools { flow-children: right; margin: 4px 0px; }
.EditorAction { padding: 6px 12px; background-color: #ffffff12; margin-right: 4px; }
.EditorAction Label, .SampleBar Label { color: #e8f2f6; font-size: 17px; }
.EditorAction:hover, .EditCell:hover { background-color: #82d7ff39; }
.EditorAction.CaorenTabSelected { background-color: #82d7ff36; }
.EditorScene { width: 100%; height: width-percentage(56.25%); background-color: #121a21; border: 1px solid #738c9a; }
.SampleArea, .CellGrid { width: 100%; height: 100%; }
.CellGrid { flow-children: down; }
.CellRow { width: 100%; height: fill-parent-flow(1); flow-children: right; }
.EditCell { width: fill-parent-flow(1); height: 100%; border: 1px solid #ffffff0c; }
.SampleBar { width: 34%; height: 16%; flow-children: right; opacity: .65; }
.SampleBar .BuffGlyph { width: 22px; height: 22px; }
.SampleBar.SelectedSample { opacity: 1; }
.SampleSkill, .SampleIntel { flow-children: none; }
.SampleSkill Label { horizontal-align: center; }
.SampleIntel Label { horizontal-align: right; }
