.BindingHudRoot
{
    width: 100%;
    height: 100%;
}

.BindingHudPanel
{
    horizontal-align: center;
    vertical-align: center;
    width: 560px;
    padding: 20px 24px;
    flow-children: down;
    background-color: #101820f5;
    border: 1px solid #73aab9aa;
    border-radius: 8px;
}

.BindingHudPanel.Hidden
{
    visibility: collapse;
}

.BindingHudPanel Label
{
    color: #e9f0f2;
    font-size: 19px;
    margin: 3px 0;
}

.BindingHudPanel .BindingHudTitle
{
    color: #b4e7ec;
    font-size: 24px;
    margin-bottom: 10px;
}
