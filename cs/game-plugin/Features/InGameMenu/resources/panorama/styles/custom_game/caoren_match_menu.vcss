.QuickMatchRoot
{
    width: 100%;
    height: 100%;
}

.QuickMatchPanel
{
    horizontal-align: center;
    vertical-align: center;
    width: 570px;
    flow-children: down;
    background-color: #111923f7;
    border: 1px solid #7298ad80;
    border-radius: 8px;
    padding: 22px;
}

.QuickMatchPanel .Hidden, .QuickMatchPanel.Hidden
{
    visibility: collapse;
}

.QuickTitle
{
    color: #e3f0f5;
    font-size: 27px;
}

.QuickStatus, .QuickHint, .QuickPage
{
    color: #aabfc9;
    font-size: 16px;
    margin: 6px 0;
}

.QuickAction, .QuickNav
{
    flow-children: right;
    background-color: #223441;
    border-radius: 4px;
    margin-top: 5px;
    padding: 8px 12px;
}

.QuickAction
{
    width: 100%;
}

.QuickAction:hover, .QuickNav:hover
{
    background-color: #396475;
}

.QuickAction.Unavailable, .QuickAction.Unavailable:hover
{
    background-color: #19242c;
}

.QuickAction Label, .QuickNav Label
{
    color: #ecf3f6;
    font-size: 20px;
}

.QuickAction.Unavailable Label
{
    color: #8496a1;
}

.QuickFooter
{
    flow-children: right;
}

.QuickFooter Button, .QuickPage
{
    margin-right: 8px;
}

.QuickTabs { width: 100%; flow-children: right; margin-bottom: 8px; }
.QuickTabs .QuickNav { margin-right: 4px; }
.QuickNav.SelectedTab { background-color: #315465; }
