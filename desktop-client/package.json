{
  "name": "caoren-cup-desktop-client",
  "version": "2.5.3",
  "private": true,
  "description": "Caotai Cup player-center Windows desktop client.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "package:win": "electron-builder --win portable",
    "package:installer": "node scripts/build-installer.js",
    "package:full": "electron-builder --win portable -c.afterAllArtifactBuild=./scripts/prepare-images.js",
    "check": "node scripts/check-config.js && node --check src/main.js && node --check src/preload.js && node --check src/device-credentials.js && node --check src/desktop-auth-client.js && node --check src/client-config.js && node --check scripts/check-config.js",
    "test": "node --test test/*.test.js"
  },
  "author": "草台杯",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.caorencup.client",
    "productName": "草台杯客户端",
    "artifactName": "草台杯客户端-v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/check-packed-app.cjs",
    "files": [
      "src/brand-icon.png",
      "src/brand.png",
      "src/client-config.js",
      "src/cs2-key-config.js",
      "src/desktop-auth-client.js",
      "src/device-credentials.js",
      "src/game-connect.js",
      "src/game-keybinds.js",
      "src/icons-license.txt",
      "src/local-images.js",
      "src/login-preferences.js",
      "src/main.js",
      "src/popup-windows.js",
      "src/popup.css",
      "src/preload.js",
      "src/room-banner.jpg",
      "src/room-keybinds.js",
      "src/room.css",
      "src/room.html",
      "src/room.js",
      "src/steam-avatar.js",
      "src/windows-steam.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
