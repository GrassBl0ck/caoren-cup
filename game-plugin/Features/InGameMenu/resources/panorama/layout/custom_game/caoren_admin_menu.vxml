                                <Panel id="guide_detail_prev_host" class="CaorenButtonHost CaorenPageHost">
                                    <Button id="guide_detail_prev" class="CaorenMenuButton">
                                        <Label class="" text="上一页" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="查看上一页" />
                                    </Panel>
                                </Panel>
                                <Panel id="guide_detail_next_host" class="CaorenButtonHost CaorenPageHost">
                                    <Button id="guide_detail_next" class="CaorenMenuButton">
                                        <Label class="" text="下一页" />
                                    </Button>
