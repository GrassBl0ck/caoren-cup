                        </Panel>
                        <Panel id="admin_settings" class="CaorenMenuSection Hidden">
                            <Label text="个人设置" class="SettingsSectionTitleLabel" />
                            <Label text="仅影响自己的菜单；两个入口共用并自动保存。 影响范围：自己。" class="CaorenGuidePage" />
                            <Panel class="CaorenPreferencesRow">
                                <Panel class="CaorenPreferenceDescription">
                                    <Label text="背景透明度" class="CaorenSettingName" />
                                    <Label text="0% 完全不透明，100% 完全透明；文字不受影响。" class="CaorenSettingScope" />
                                </Panel>
                                <Panel class="CaorenNumberSteps">
                                    <Panel id="settings_alpha_minus5_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotMinus5">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_alpha_minus5">
                                            <Label text="−5" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="减少透明度5%" />
                                        </Panel>
                                    </Panel>
                                    <Panel id="settings_alpha_minus1_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotMinus1">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_alpha_minus1">
                                            <Label text="−1" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="减少透明度1%" />
                                        </Panel>
                                    </Panel>
                                    <Label class="CaorenPreferenceValue CaorenNumberCurrent" text="{s:settings_alpha}" />
                                    <Panel id="settings_alpha_plus1_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotPlus1">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_alpha_plus1">
                                            <Label text="+1" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="增加透明度1%" />
                                        </Panel>
                                    </Panel>
                                    <Panel id="settings_alpha_plus5_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotPlus5">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_alpha_plus5">
                                            <Label text="+5" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="增加透明度5%" />
                                        </Panel>
                                    </Panel>
                                </Panel>
                            </Panel>
                            <Panel class="CaorenPreferencesRow">
                                <Panel class="CaorenPreferenceDescription">
                                    <Label text="草人杯音量" class="CaorenSettingName" />
                                    <Label text="控制已接入统一音频服务的草人杯声音。" class="CaorenSettingScope" />
                                </Panel>
                                <Panel class="CaorenNumberSteps">
                                    <Panel id="settings_volume_minus5_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotMinus5">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_volume_minus5">
                                            <Label text="−5" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="减少草人杯音量5%" />
                                        </Panel>
                                    </Panel>
                                    <Panel id="settings_volume_minus1_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotMinus1">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_volume_minus1">
                                            <Label text="−1" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="减少草人杯音量1%" />
                                        </Panel>
                                    </Panel>
                                    <Label class="CaorenPreferenceValue CaorenNumberCurrent" text="{s:settings_volume}" />
                                    <Panel id="settings_volume_plus1_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotPlus1">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_volume_plus1">
                                            <Label text="+1" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="增加草人杯音量1%" />
                                        </Panel>
                                    </Panel>
                                    <Panel id="settings_volume_plus5_host" class="CaorenButtonHost CaorenNumberHost CaorenNumberSlotPlus5">
                                        <Button class="CaorenNumberStep CaorenMenuButton" id="settings_volume_plus5">
                                            <Label text="+5" />
                                        </Button>
                                        <Panel class="CaorenHoverHint" hittest="false">
                                            <Label class="CaorenHoverHintText" text="增加草人杯音量5%" />
                                        </Panel>
                                    </Panel>
                                </Panel>
                            </Panel>
                        </Panel>
                    </Panel>
                </Panel>
            </Panel>
            <Panel class="CaorenNavigationOverlay" hittest="false">
                <Panel id="admin_back_host" class="CaorenButtonHost CaorenBackHost Hidden">
                    <Button id="admin_back" class="CaorenBackArrow Hidden CaorenMenuButton">
                        <Panel class="CaorenBackContent" hittest="false">
                            <Label class="CaorenBackSymbol" text="‹" />
                            <Label class="CaorenBackText" text="返回" />
                        </Panel>
                    </Button>
                    <Panel class="CaorenHoverHint HintBelow" hittest="false">
                        <Label class="CaorenHoverHintText" text="返回上一级" />
                    </Panel>
                </Panel>
                <Panel id="admin_exit_host" class="CaorenButtonHost CaorenExitHost">
                    <Button id="admin_exit" class="CaorenExitButton CaorenMenuButton">
                        <Label text="X" class="CaorenExitGlyph" />
                    </Button>
                    <Panel class="CaorenHoverHint HintBelow" hittest="false">
                        <Label class="CaorenHoverHintText" text="退出菜单，返回游戏" />
                    </Panel>
                </Panel>
                <Label class="CaorenBottomBrand" text="CAORENCUP · 管理员" />
            </Panel>
        </Panel>
    </Panel>
</root>
