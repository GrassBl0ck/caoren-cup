                        </Panel>
                        <Panel id="admin_help_detail" class="CaorenMenuSection Hidden">
                            <Label class="SettingsSectionTitleLabel" text="{s:guide_detail_name}" />
                            <Label class="CaorenVoteQuestion" text="{s:guide_detail_summary}" />
                            <Label class="CaorenGuideMeta" text="{s:guide_detail_meta}" />
                            <Panel class="CaorenDetailRows" hittest="false">
