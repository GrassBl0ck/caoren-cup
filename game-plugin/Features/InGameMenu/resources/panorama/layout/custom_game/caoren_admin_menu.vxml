<root>
    <styles>
        <include src="s2r://panorama/styles/csgostyles.vcss_c" />
        <include src="s2r://panorama/styles/mainmenu.vcss_c" />
        <include src="s2r://panorama/styles/settings/settings.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/caoren_admin_menu.vcss_c" />
    </styles>
    <Panel class="CaorenAdminRoot" hittest="false">
        <Panel id="dialog" class="CaorenSettings UserAlpha10 Hidden" hittest="true">
            <Panel class="CaorenMenuBody">
                <Panel class="content-navbar__tabs CaorenPrimaryNav">
                    <Panel class="content-navbar__tabs__center-container">
                        <Panel id="admin_home_tab_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenTabSelected CaorenMenuButton" id="admin_home_tab">
                                <Label text="快捷指令" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="打开快捷指令" />
                            </Panel>
                        </Panel>
                        <Panel id="admin_help_open_tab_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenMenuButton" id="admin_help_open_tab">
                                <Label text="指令帮助" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="查看管理员指令" />
                            </Panel>
                        </Panel>
                        <Panel id="admin_settings_open_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenMenuButton" id="admin_settings_open">
                                <Label text="个人设置" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="调整自己的菜单和音量" />
                            </Panel>
                        </Panel>
                    </Panel>
                </Panel>
                <Panel class="content-navbar__tabs content-navbar__tabs--dark CaorenSecondaryNav">
                    <Panel class="content-navbar__tabs__center-container">
                        <Panel class="content-navbar__tabs__btn CaorenTabSelected">
                            <Label text="{s:subsection}" />
                        </Panel>
                    </Panel>
                </Panel>
                <Panel class="SettingsMenuTab Active CaorenSettingsPage">
                    <Panel class="SettingsBackground CaorenSettingsContent">
                        <Panel id="admin_home" class="CaorenMenuSection">
                            <Panel class="SettingsSectionTitleContianer CaorenSectionHeader">
                                <Label class="SettingsSectionTitleLabel" text="广播" />
                            </Panel>
                            <Panel class="SettingsMenuDropdownContainer CaorenSettingsRow">
                                <Panel class="CaorenSettingDescription">
                                    <Label class="CaorenSettingName" text="全服广播" />
                                    <Label class="CaorenSettingScope" text="{s:status}" />
                                </Panel>
                                <Panel id="menu_btn_0_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="menu_btn_0" class="CaorenSettingAction CaorenMenuButton">
                                        <Label text="{s:btn0}" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="向全服发送广播" />
                                    </Panel>
                                </Panel>
                            </Panel>
                            <Panel class="content-navbar__seperator CaorenRowSeparator" />
                            <Panel class="SettingsMenuDropdownContainer CaorenSettingsRow">
                                <Panel class="CaorenSettingDescription">
                                    <Label class="CaorenSettingName" text="投票系统" />
                                    <Label class="CaorenSettingScope" text="影响范围：全服 · 管理员专属" />
                                </Panel>
                                <Panel id="admin_vote_open_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="admin_vote_open" class="CaorenSettingAction CaorenMenuButton">
                                        <Label class="" text="管理投票" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="管理全服投票" />
                                    </Panel>
                                </Panel>
                            </Panel>
<Panel class="SettingsMenuDropdownContainer CaorenSettingsRow">
<Panel class="CaorenSettingDescription"><Label class="CaorenSettingName" text="音乐与音频广播" />
<Label class="CaorenSettingScope" text="影响范围：全服 · 管理员控制" /></Panel><Panel id="admin_audio_open_host" class="CaorenButtonHost CaorenActionHost">
<Button id="admin_audio_open" class="CaorenMenuButton"><Label text="管理音频" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="管理音乐和音频广播" /></Panel>
</Panel></Panel>
                        </Panel>
                        <Panel id="admin_audio" class="CaorenMenuSection Hidden">
<Label class="SettingsSectionTitleLabel" text="音乐与音频广播" />
<Label class="CaorenSettingScope" text="影响范围：全服 · 两通道独立 · 个人音量只影响自己" />
<Label class="CaorenSettingName" text="音乐" />
<Label class="CaorenSettingScope" text="{s:audio_music_state}" />
<Label class="CaorenSettingScope" text="{s:audio_music_cycle}" />
<Panel class="CaorenAudioControls">
<Panel id="audio_music_pause_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_music_pause" class="CaorenMenuButton"><Label text="暂停" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="暂停当前通道" /></Panel>
</Panel>
<Panel id="audio_music_resume_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_music_resume" class="CaorenMenuButton"><Label text="恢复" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="从原进度恢复" /></Panel>
</Panel>
<Panel id="audio_music_stop_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_music_stop" class="CaorenMenuButton"><Label text="停止" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="停止当前通道" /></Panel>
</Panel>
<Panel id="audio_music_loop_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_music_loop" class="CaorenMenuButton"><Label text="{s:audio_music_loop_label}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="切换循环，关闭后本轮播完停止" /></Panel>
</Panel>
</Panel>
<Label class="CaorenSettingName" text="广播" />
<Label class="CaorenSettingScope" text="{s:audio_broadcast_state}" />
<Label class="CaorenSettingScope" text="{s:audio_broadcast_cycle}" />
<Panel class="CaorenAudioControls">
<Panel id="audio_broadcast_pause_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_broadcast_pause" class="CaorenMenuButton"><Label text="暂停" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="暂停当前通道" /></Panel>
</Panel>
<Panel id="audio_broadcast_resume_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_broadcast_resume" class="CaorenMenuButton"><Label text="恢复" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="从原进度恢复" /></Panel>
</Panel>
<Panel id="audio_broadcast_stop_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_broadcast_stop" class="CaorenMenuButton"><Label text="停止" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="停止当前通道" /></Panel>
</Panel>
<Panel id="audio_broadcast_loop_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_broadcast_loop" class="CaorenMenuButton"><Label text="{s:audio_broadcast_loop_label}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="切换循环，关闭后本轮播完停止" /></Panel>
</Panel>
</Panel>
<Label class="CaorenSettingScope" text="{s:audio_library_page}" />
<Panel id="audio_item_0_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_0" class="CaorenMenuButton"><Label text="{s:audio_name0}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel id="audio_item_1_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_1" class="CaorenMenuButton"><Label text="{s:audio_name1}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel id="audio_item_2_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_2" class="CaorenMenuButton"><Label text="{s:audio_name2}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel id="audio_item_3_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_3" class="CaorenMenuButton"><Label text="{s:audio_name3}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel id="audio_item_4_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_4" class="CaorenMenuButton"><Label text="{s:audio_name4}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel id="audio_item_5_host" class="CaorenButtonHost CaorenAudioItem">
<Button id="audio_item_5" class="CaorenMenuButton"><Label text="{s:audio_name5}" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="播放到该素材登记的通道" /></Panel>
</Panel>
<Panel class="CaorenAudioControls">
<Panel id="audio_prev_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_prev" class="CaorenMenuButton"><Label text="上一页" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="查看上一页素材" /></Panel>
</Panel>
<Panel id="audio_next_host" class="CaorenButtonHost CaorenAudioButton">
<Button id="audio_next" class="CaorenMenuButton"><Label text="下一页" /></Button>
<Panel class="CaorenHoverHint" hittest="false"><Label class="CaorenHoverHintText" text="查看下一页素材" /></Panel>
</Panel>
</Panel>
</Panel>
<Panel id="admin_vote_management" class="CaorenMenuSection Hidden">
                            <Label class="SettingsSectionTitleLabel" text="投票管理" />
                            <Label class="CaorenVoteQuestion" text="{s:vote_admin_question}" />
                            <Label class="CaorenVoteState" text="{s:vote_admin_state}" />
                            <Label class="CaorenSettingScope" text="影响范围：全服 · 30 秒 · 非管理员真人投票" />
                            <Panel class="CaorenVoteActions">
                                <Panel id="vote_create_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="vote_create" class="CaorenMenuButton">
                                        <Label class="" text="{s:vote_create_label}" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="填写投票问题和选项" />
                                    </Panel>
                                </Panel>
                                <Panel id="vote_cancel_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="vote_cancel" class="Negative CaorenMenuButton">
                                        <Label class="" text="取消当前投票" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="取消正在进行的投票" />
                                    </Panel>
                                </Panel>
                            </Panel>
                        </Panel>
                        <Panel id="admin_vote_preview" class="CaorenMenuSection Hidden">
                            <Label class="SettingsSectionTitleLabel" text="确认发起投票" />
                            <Label class="CaorenVoteQuestion" text="{s:vote_draft_question}" />
                            <Label class="CaorenVoteChoice" text="{s:vote_draft_option0}" id="vote_draft_option0" />
                            <Label class="CaorenVoteChoice" text="{s:vote_draft_option1}" id="vote_draft_option1" />
                            <Label class="CaorenVoteChoice" text="{s:vote_draft_option2}" id="vote_draft_option2" />
                            <Label class="CaorenVoteChoice" text="{s:vote_draft_option3}" id="vote_draft_option3" />
                            <Label class="CaorenSettingScope" text="影响范围：全服 · 确认后立即开始，持续 30 秒" />
                            <Panel class="CaorenVoteActions">
                                <Panel id="vote_start_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="vote_start" class="CaorenMenuButton">
                                        <Label class="" text="确认发起" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="向全服发起投票" />
                                    </Panel>
                                </Panel>
                                <Panel id="vote_discard_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="vote_discard" class="CaorenMenuButton">
                                        <Label class="" text="丢弃草稿" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="丢弃这份投票草稿" />
                                    </Panel>
                                </Panel>
                            </Panel>
                        </Panel>
                        <Panel id="admin_vote_cancel" class="CaorenMenuSection Hidden">
                            <Label class="SettingsSectionTitleLabel" text="确认取消投票" />
                            <Label class="CaorenVoteQuestion" text="{s:vote_cancel_question}" />
                            <Label class="CaorenVoteState" text="确认取消本轮投票？取消后不产生胜出选项。" />
                            <Panel class="CaorenVoteActions">
                                <Panel id="vote_cancel_confirm_host" class="CaorenButtonHost CaorenActionHost">
                                    <Button id="vote_cancel_confirm" class="Negative CaorenMenuButton">
                                        <Label class="" text="确认取消" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="确认取消当前投票" />
                                    </Panel>
                                </Panel>
                            </Panel>
                        </Panel>
                        <Panel id="admin_help_list" class="CaorenMenuSection Hidden">
                            <Label class="SettingsSectionTitleLabel" text="指令帮助" />
                            <Label class="CaorenGuidePage" text="{s:guide_page}" />
                            <Panel id="guide_item_0_host" class="CaorenButtonHost CaorenGuideHost">
                                <Button id="guide_item_0" class="CaorenGuideItem CaorenMenuButton">
                                    <Label class="CaorenGuideName" text="{s:guide_name0}" />
                                    <Label class="CaorenGuideSummary" text="{s:guide_summary0}" />
                                </Button>
                                <Panel class="CaorenHoverHint" hittest="false">
