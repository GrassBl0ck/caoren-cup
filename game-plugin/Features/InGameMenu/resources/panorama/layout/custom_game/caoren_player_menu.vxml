<root>
    <styles>
        <include src="s2r://panorama/styles/csgostyles.vcss_c" />
        <include src="s2r://panorama/styles/mainmenu.vcss_c" />
        <include src="s2r://panorama/styles/settings/settings.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/caoren_admin_menu.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/caoren_player_menu.vcss_c" />
    </styles>
    <Panel class="CaorenAdminRoot" hittest="false">
        <Panel id="dialog" class="CaorenSettings UserAlpha10 Hidden" hittest="true">
            <Panel class="CaorenMenuBody">
                <Panel class="content-navbar__tabs CaorenPrimaryNav">
                    <Panel class="content-navbar__tabs__center-container">
                        <Panel id="player_commands_open_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenTabSelected CaorenMenuButton" id="player_commands_open">
                                <Label text="玩家指令" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="查看玩家指令" />
                            </Panel>
                        </Panel>
                        <Panel id="player_vote_open_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenMenuButton" id="player_vote_open">
                                <Label text="投票" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="打开当前投票" />
                            </Panel>
                        </Panel>
                        <Panel id="player_settings_open_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenMenuButton" id="player_settings_open">
                                <Label text="个人设置" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="调整自己的菜单和音量" />
                            </Panel>
                        </Panel>
                        <Panel id="player_guide_open_host" class="CaorenButtonHost CaorenNavHost">
                            <Button class="CaorenNavTab CaorenMenuButton" id="player_guide_open">
                                <Label text="打开指引" />
                            </Button>
                            <Panel class="CaorenHoverHint HintBelow" hittest="false">
                                <Label class="CaorenHoverHintText" text="查看打开方式和键位设置" />
                            </Panel>
                        </Panel>
                    </Panel>
                </Panel>
                <Panel class="content-navbar__tabs content-navbar__tabs--dark CaorenSecondaryNav">
                    <Label text="{s:player_section}" class="CaorenPlayerSection" />
                </Panel>
                <Panel class="SettingsMenuTab Active CaorenSettingsPage">
                    <Panel class="SettingsBackground CaorenSettingsContent">
                        <Panel id="player_commands" class="CaorenMenuSection Hidden">
                            <Label text="玩家指令" class="SettingsSectionTitleLabel" />
                            <Label text="{s:player_commands_page}" class="CaorenGuidePage" />
                            <Panel id="player_cmd_0_host" class="CaorenButtonHost CaorenGuideHost">
                                <Button id="player_cmd_0" class="CaorenGuideItem CaorenMenuButton">
                                    <Label text="{s:player_cmd_name0}" class="CaorenGuideName" />
                                    <Label text="{s:player_cmd_summary0}" class="CaorenGuideSummary" />
                                </Button>
                                <Panel class="CaorenHoverHint" hittest="false">
                                    <Label class="CaorenHoverHintText" text="查看指令用法和示例" />
                                </Panel>
                            </Panel>
                            <Panel id="player_cmd_1_host" class="CaorenButtonHost CaorenGuideHost">
                                <Button id="player_cmd_1" class="CaorenGuideItem CaorenMenuButton">
                                    <Label text="{s:player_cmd_name1}" class="CaorenGuideName" />
                                    <Label text="{s:player_cmd_summary1}" class="CaorenGuideSummary" />
                                </Button>
                                <Panel class="CaorenHoverHint" hittest="false">
                                    <Label class="CaorenHoverHintText" text="查看指令用法和示例" />
                                </Panel>
                            </Panel>
                            <Panel id="player_cmd_2_host" class="CaorenButtonHost CaorenGuideHost">
