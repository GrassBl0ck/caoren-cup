                                    <Label text="{s:player_cmd_name2}" class="CaorenGuideName" />
                                    <Label text="{s:player_cmd_summary2}" class="CaorenGuideSummary" />
                                </Button>
                                <Panel class="CaorenHoverHint" hittest="false">
                                    <Label class="CaorenHoverHintText" text="查看指令用法和示例" />
                                </Panel>
                            </Panel>
                            <Panel id="player_cmd_3_host" class="CaorenButtonHost CaorenGuideHost">
                                <Button id="player_cmd_3" class="CaorenGuideItem CaorenMenuButton">
                                    <Label text="{s:player_cmd_name3}" class="CaorenGuideName" />
                                    <Label text="{s:player_cmd_summary3}" class="CaorenGuideSummary" />
                                </Button>
                                <Panel class="CaorenHoverHint" hittest="false">
                                    <Label class="CaorenHoverHintText" text="查看指令用法和示例" />
                                </Panel>
