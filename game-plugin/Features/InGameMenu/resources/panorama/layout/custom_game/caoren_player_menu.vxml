                            </Panel>
                        </Panel>
                        <Panel id="player_open_guide" class="CaorenMenuSection Hidden">
                            <Label text="自定义打开草人杯菜单" class="SettingsSectionTitleLabel" />
                            <Label text="聊天输入 /cm 打开玩家菜单；管理员输入 /ca；/cv 打开投票。" class="CaorenGuidePage" />
                            <Label text="在 CS2 设置中启用开发者控制台，再打开控制台。" class="CaorenGuidePage" />
                            <Label text="输入 bind &quot;F6&quot; &quot;css_crcmenu&quot;，按 F6 即可打开或关闭玩家菜单。" class="CaorenGuidePage" />
                            <Label text="管理员可输入 bind &quot;F7&quot; &quot;css_crcmenu_admin&quot;。" class="CaorenGuidePage" />
                            <Label text="返回：bind &quot;F8&quot; &quot;css_crcmenu_back&quot;；退出：bind &quot;F9&quot; &quot;css_crcmenu_exit&quot;。" class="CaorenGuidePage" />
                            <Label text="如果这些键已有用途，请换成空闲键。草人杯不会自动修改你的键位。" class="CaorenGuidePage" />
                            <Label text="暂不建议覆盖 Esc：覆盖后会改变游戏原有暂停菜单入口。" class="CaorenGuidePage" />
                            <Label text="以上命令只在装有草人杯菜单的服务器有效；界面还需要对应资源包。" class="CaorenGuidePage" />
                        </Panel>
                    </Panel>
                </Panel>
            </Panel>
            <Panel class="CaorenNavigationOverlay" hittest="false">
                <Panel id="player_back_host" class="CaorenButtonHost CaorenBackHost Hidden">
                    <Button id="player_back" class="CaorenBackArrow Hidden CaorenMenuButton">
                        <Panel class="CaorenBackContent" hittest="false">
                            <Label class="CaorenBackSymbol" text="‹" />
                            <Label class="CaorenBackText" text="返回" />
                        </Panel>
                    </Button>
                    <Panel class="CaorenHoverHint HintBelow" hittest="false">
                        <Label class="CaorenHoverHintText" text="返回上一级" />
                    </Panel>
                </Panel>
                <Panel id="player_exit_host" class="CaorenButtonHost CaorenExitHost">
                    <Button id="player_exit" class="CaorenExitButton CaorenMenuButton">
                        <Label text="X" class="CaorenExitGlyph" />
                    </Button>
                    <Panel class="CaorenHoverHint HintBelow" hittest="false">
                        <Label class="CaorenHoverHintText" text="退出菜单，返回游戏" />
                    </Panel>
                </Panel>
                <Label class="CaorenBottomBrand" text="CAORENCUP · 玩家" />
            </Panel>
        </Panel>
    </Panel>
</root>
