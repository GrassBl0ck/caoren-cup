                                <Panel class="CaorenHoverHint" hittest="false">
                                    <Label class="CaorenHoverHintText" text="查看指令用法和示例" />
                                </Panel>
                            </Panel>
                            <Panel class="CaorenVoteActions">
                                <Panel id="player_cmd_prev_host" class="CaorenButtonHost CaorenPageHost">
                                    <Button id="player_cmd_prev" class="CaorenMenuButton">
                                        <Label text="上一页" class="" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="查看上一页" />
                                    </Panel>
                                </Panel>
                                <Panel id="player_cmd_next_host" class="CaorenButtonHost CaorenPageHost">
                                    <Button id="player_cmd_next" class="CaorenMenuButton">
                                        <Label text="下一页" class="" />
                                    </Button>
                                    <Panel class="CaorenHoverHint" hittest="false">
                                        <Label class="CaorenHoverHintText" text="查看下一页" />
                                    </Panel>
                                </Panel>
                            </Panel>
                        </Panel>
