/* 原生视觉来源（本机 pak01_dir.vpk 已提取核对）：
   csgostyles.vcss_c：字体、PopupButton、悬停与点击音效。
   mainmenu.vcss_c：全屏半透明底色、bluedots 底纹、顶部导航、选中颜色。
   settings/settings.vcss_c：设置页内容宽度、设置行、分区标题。
   不替换游戏原有资源。此文件补充自定义布局尺寸和当前分类的选中状态。
   实时地图模糊未接入；不使用未经验证的 CSS 属性或客户端脚本。 */

.CaorenAdminRoot
{
    width: 100%;
    height: 100%;
}

.CaorenSettings
{
    width: 100%;
    height: 100%;
    flow-children: down;
    padding-top: 0px;
    /* 默认背景透明度 10%，只调整背景，不降低文字和按钮的不透明度。 */
    background-color: rgba(20, 20, 20, 0.90);
    opacity: 1;
}

.CaorenSettings.Hidden
{
    visibility: collapse;
    opacity: 0;
}

.CaorenPrimaryNav
{
    height: 64px;
    flow-children: none;
}

.CaorenBrand
{
    horizontal-align: left;
    font-size: 24px;
    margin-left: 32px;
}

.CaorenSecondaryNav
{
    height: 48px;
}

/* 对应 mainmenu.vcss_c 中原生导航 :selected 的底色与文字色。 */
.CaorenTabSelected
{
    background-color: #82d7ff1a;
}

.CaorenTabSelected Label
{
    color: #82D8FF;
}

.CaorenSettingsPage
{
    height: fill-parent-flow(1);
}

.CaorenSettingsContent
{
    margin-top: 32px;
}

.CaorenSectionHeader
{
    margin-bottom: 24px;
}

.CaorenSettingsRow
{
    min-height: 80px;
    flow-children: none;
}

.CaorenSettingDescription
{
    width: 60%;
    vertical-align: center;
    flow-children: down;
}

.CaorenSettingName
{
    font-size: 20px;
    color: #ccccccff;
}

.CaorenSettingScope
{
    margin-top: 4px;
    font-size: 14px;
    color: rgba(222, 222, 222, 0.4);
}

.CaorenSettingAction
{
    horizontal-align: right;
    vertical-align: center;
}

.CaorenRowSeparator
{
    opacity: 0.10;
}

/* 投票管理页与返回/退出；不改变普通构建的开发控件排除规则。 */
Panel.Hidden, Label.Hidden, Button.Hidden { visibility: collapse; }
.CaorenMenuSection { width: 100%; flow-children: down; }
.CaorenVoteQuestion { width: 100%; font-size: 24px; color: #ccccccff; margin-top: 24px; margin-bottom: 12px; }
.CaorenVoteState { width: 100%; font-size: 18px; color: #ccccccff; margin-bottom: 16px; }
.CaorenVoteChoice { width: 100%; font-size: 20px; color: #ccccccff; margin-bottom: 12px; }
.CaorenVoteActions { flow-children: right; horizontal-align: right; margin-top: 24px; }
.CaorenSettingsFooter { width: fit-children; height: 64px; horizontal-align: right; flow-children: right; margin-right: 64px; margin-bottom: 16px; }

/* 指令帮助只读列表与详情页，使用原生 PopupButton/字体。 */
.CaorenHelpTab { margin-left: 24px; }
.CaorenHelpTab Label { font-size: 16px; }
.CaorenGuidePage { width: 100%; color: #ccccccff; font-size: 16px; margin-top: 12px; margin-bottom: 12px; }
.CaorenGuideItem { width: 100%; height: 54px; margin: 0px; flow-children: right; border-bottom: 1px solid #ffffff19; }
.CaorenGuideItem .CaorenGuideName { width: 32%; horizontal-align: left; text-align: left; font-size: 20px; }
.CaorenGuideItem .CaorenGuideSummary { width: 65%; horizontal-align: left; text-align: left; font-size: 16px; }
.CaorenGuideMeta { width: 100%; color: #ccccccff; font-size: 16px; margin-bottom: 16px; }
.CaorenGuideDetail { width: 100%; color: #ccccccff; font-size: 18px; line-height: 24px; }

/* 生产个人设置：背景透明度和本插件提示音音量。 */
.CaorenPreferencesRow { width: 100%; height: 112px; flow-children: none; border-bottom: 1px solid #ffffff19; }
.CaorenPreferenceDescription { width: 55%; vertical-align: center; flow-children: down; }
.CaorenPreferencesRow .CaorenSettingScope { color: #bbbbbbff; font-size: 14px; }
/* 数值按钮和固定导航。边界按钮仍由服务器 clamp，CSS 不拦截整体菜单输入。 */
.CaorenNumberSteps { width: 360px; height: 48px; horizontal-align: right; vertical-align: center; flow-children: none; }
.CaorenNumberStep { width: 56px; height: 48px; margin: 0px; padding: 0px; border: 1px solid #ffffff33; }
.CaorenNumberStep Label { horizontal-align: center; vertical-align: center; font-size: 18px; }
.CaorenNumberStep.AtBoundary { opacity: 0.35; }
.CaorenPreferenceValue { width: 96px; height: 48px; vertical-align: center; text-align: center; font-size: 20px; color: #ccccccff; padding-top: 10px; }
.CaorenNavTab { min-width: 120px; height: 64px; }
.CaorenNavTab Label { vertical-align: center; horizontal-align: center; }
.CaorenGuideDetail { margin-top: 8px; line-height: 28px; }
/* 悬浮提示的容器固定占位，提示在 none 布局层内绘制，不参与按钮的尺寸计算。
   正式按钮暂未配置提示。开发用例显式选择方向，所有提示层都禁用 hittest。 */
.CaorenTooltipHost { width: 240px; height: 48px; flow-children: none; overflow: noclip; }
.CaorenTooltipAnchor { width: 240px; height: 48px; }
.CaorenTooltip { visibility: collapse; opacity: 0; width: 340px; flow-children: down; background-color: #202020fa; border: 1px solid #ffffff33; padding: 12px; z-index: 100; }
.CaorenTooltipHost:hover .CaorenTooltip { visibility: visible; opacity: 1; }
.TooltipAbove .CaorenTooltip { vertical-align: bottom; margin-bottom: 60px; }
.TooltipBelow .CaorenTooltip { position: 0px 60px 0px; }
.TooltipLeft .CaorenTooltip { position: -352px 0px 0px; }
.TooltipRight .CaorenTooltip { position: 252px 0px 0px; }
.CaorenTooltipText { width: 100%; font-size: 16px; color: #ccccccff; }
.CaorenTooltipImage { width: 280px; height: 80px; margin-top: 8px; }
