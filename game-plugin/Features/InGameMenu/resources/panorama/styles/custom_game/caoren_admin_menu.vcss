.CaorenSettings.MenuVolume31 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover31"; }
.CaorenSettings.MenuVolume32 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover32"; }
.CaorenSettings.MenuVolume33 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover33"; }
.CaorenSettings.MenuVolume34 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover34"; }
.CaorenSettings.MenuVolume35 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover35"; }
