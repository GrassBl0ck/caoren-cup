/* Custom HUD 不允许 html 属性，使用独立 Label 保留参数色和标题粗体。 */
.CaorenDetailRows { width: 100%; flow-children: down; margin-top: 8px; }
.CaorenDetailLine { width: 100%; height: 28px; flow-children: right; }
.CaorenDetailFragment { width: fit-children; height: 28px; font-size: 18px; line-height: 28px; color: #ccccccff; }
.CaorenDetailLine.HelpHeading .CaorenDetailFragment { font-weight: bold; }
.CaorenDetailFragment.HelpParam0 { color: #82D8FF; }
.CaorenDetailFragment.HelpParam1 { color: #FFC776; }
.CaorenDetailFragment.HelpParam2 { color: #B5E48C; }
.CaorenDetailFragment.HelpParam3 { color: #D7A8FF; }
.CaorenDetailFragment.HelpParam4 { color: #FF9EAA; }
.CaorenDetailFragment.HelpParam5 { color: #80E0CF; }
.CaorenDetailFragment.HelpParam6 { color: #F2E58C; }
.CaorenDetailFragment.HelpParam7 { color: #A8B8FF; }


/* 背景根容器无流布局，主体与导航都是从左上角开始的独立层。 */
.CaorenSettings { flow-children: none; background-image: none; transition-duration: 0s; }
.CaorenMenuBody { width: 100%; height: 100%; flow-children: down; }
.CaorenNavigationOverlay { width: 100%; height: 100%; position: 0px 0px 0px; flow-children: none; z-index: 20; }
.CaorenBottomBrand { horizontal-align: left; vertical-align: bottom; margin: 24px 32px; font-size: 22px; font-weight: bold; color: #ccccccff; }
.CaorenButtonHost { width: 200px; height: 56px; margin: 4px; horizontal-align: right; vertical-align: center; flow-children: none; overflow: noclip; }
.CaorenNumberHost { width: 56px; height: 48px; margin: 0px; horizontal-align: left; }
.CaorenNavHost { width: 120px; height: 64px; margin: 0px; }
.CaorenGuideHost { width: 100%; height: 54px; margin: 0px; }
.CaorenVoteHost { width: 100%; height: 80px; margin: 0px; }
.CaorenPageHost { width: 120px; height: 48px; }
.CaorenBackHost { width: 120px; height: 56px; margin: 4px 24px; horizontal-align: left; vertical-align: top; }
.CaorenExitHost { width: 64px; height: 56px; margin: 4px 24px; horizontal-align: right; vertical-align: top; }

/* 业务按钮使用自己的静态视觉样式，不挂原生 PopupButton 的自动声音。 */
.CaorenMenuButton { width: 100%; height: 100%; min-width: 0px; min-height: 0px; margin: 0px; padding: 0px; flow-children: none; background-color: #ffffff00; border-radius: 3px; transition-property: background-color; transition-duration: .1s; }
.CaorenMenuButton:hover { background-color: #ffffff22; }
.CaorenMenuButton Label { margin: 0px; font-family: Stratum2, "Arial Unicode MS"; font-size: 20px; font-weight: medium; text-transform: none; color: #ffffffff; horizontal-align: center; vertical-align: center; text-align: center; }
.CaorenMenuButton.CaorenNavTab { min-width: 0px; }
.CaorenNavTab Label { font-size: 16px; }
.CaorenTabSelected Label { color: #82D8FF; }
.CaorenNumberStep Label { width: fit-children; height: fit-children; padding: 0px; font-size: 18px; }
.CaorenPreferenceValue { width: 96px; height: 48px; margin: 0px; padding-top: 10px; }
.CaorenMenuButton.Negative { background-color: #a83c3c66; }
.CaorenMenuButton.Negative:hover { background-color: #bd444499; }
.CaorenBackArrow, .CaorenExitButton { background-color: #ffffff18; border: 1px solid #ffffff55; }
.CaorenBackContent { width: fit-children; height: fit-children; flow-children: right; horizontal-align: center; vertical-align: center; }
.CaorenBackContent .CaorenBackSymbol { font-size: 34px; margin-right: 6px; color: #ffffffff; }
.CaorenBackContent .CaorenBackText { font-size: 24px; color: #ffffffff; }
.CaorenExitButton .CaorenExitGlyph { width: 100%; height: fit-children; font-size: 40px; font-weight: bold; color: #ff6262ff; text-align: center; horizontal-align: center; vertical-align: center; }
.CaorenGuideItem { flow-children: right; }
.CaorenGuideItem .CaorenGuideName { width: 32%; text-align: left; horizontal-align: left; font-size: 20px; }
.CaorenGuideItem .CaorenGuideSummary { width: 65%; text-align: left; horizontal-align: left; font-size: 16px; }
/* 提示与按钮互为兄弟，不继承 PopupButton Label 的字体、边距和占位。 */
.CaorenHoverHint { visibility: collapse; width: 240px; height: 36px; padding: 8px 12px; position: 0px -40px 0px; background-color: #202020ff; border: 1px solid #ffffff55; z-index: 100; }
.CaorenHoverHintText { width: 100%; height: 20px; color: #eeeeeeff; font-size: 16px; margin: 0px; text-transform: none; }
.CaorenButtonHost:hover { z-index: 100; }
.CaorenButtonHost:hover .CaorenHoverHint { visibility: visible; }
.CaorenHoverHint.HintBelow { position: 0px 68px 0px; }
.CaorenExitHost .CaorenHoverHint { horizontal-align: right; position: 0px 60px 0px; }
.CaorenSettingsPage, .CaorenSettingsContent, .CaorenMenuSection, .CaorenVoteActions, .CaorenNumberSteps, .CaorenPrimaryNav { overflow: noclip; }
/* 菜单自加音效由服务器音频服务按个人音量播放，取消原生 CSS 自动播放。 */
.CaorenSettings Button.CaorenMenuButton:hover, .CaorenSettings Button.CaorenMenuButton:enabled:hover,
.CaorenSettings Button.CaorenMenuButton:active, .CaorenSettings Button.CaorenMenuButton.Activated { sound: ""; }
.CaorenSettings Button.CaorenMenuButton Label,
.CaorenSettings Button.CaorenMenuButton:selected Label { sound: ""; }
/* 临时回退：划过用游戏原生声音，0% 不启用此类；非零比例尚未验证。 */


/* 内容区域不沿用原生 SettingsBackground 的内边距，避免百分比子项越过可用区域。 */
.CaorenSettingsContent { width: 946px; padding: 0px; margin-top: 74px; }
/* 五个槽位均相对自己的固定面板定位，右端另留 16px，不依赖流式裁剪边界。 */
.CaorenNumberHost { horizontal-align: left; vertical-align: top; }
.CaorenNumberSlotMinus5 { position: 0px 0px 0px; }
.CaorenNumberSlotMinus1 { position: 62px 0px 0px; }
.CaorenNumberCurrent { position: 124px 0px 0px; horizontal-align: left; vertical-align: top; }
.CaorenNumberSlotPlus1 { position: 226px 0px 0px; }
.CaorenNumberSlotPlus5 { position: 288px 0px 0px; }

/* 音频管理沿用已验收的静态按钮，悬停不修改文字或尺寸。 */
.CaorenAudioControls { flow-children: right; width: 100%; height: 50px; margin: 6px 0px 12px 0px; overflow: noclip; }
.CaorenAudioButton { width: 140px; height: 44px; margin-right: 12px; }
.CaorenAudioItem { width: 100%; height: 42px; margin: 3px 0px; }
.CaorenAudioItem .CaorenMenuButton { background-color: #ffffff12; }
.CaorenAudioItem .CaorenMenuButton:hover { background-color: #ffffff28; }
.CaorenAudioItem .CaorenMenuButton Label { font-size: 18px; }

/* 个人悬停声音分档，0% 保持无声；原生素材不写入资源包。 */
.CaorenSettings.MenuVolume1 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover1"; }
.CaorenSettings.MenuVolume2 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover2"; }
.CaorenSettings.MenuVolume3 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover3"; }
.CaorenSettings.MenuVolume4 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover4"; }
