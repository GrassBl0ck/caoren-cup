.CaorenSettings.MenuVolume12 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover12"; }
.CaorenSettings.MenuVolume13 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover13"; }
.CaorenSettings.MenuVolume14 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover14"; }
.CaorenSettings.MenuVolume15 Button.CaorenMenuButton:enabled:hover { sound: "caorencup.ui.hover15"; }
