/* 原生底色、字体、底纹和按钮样式；左侧位置参照用户截图。 */
.CaorenVoteRoot { width: 100%; height: 100%; }
.CaorenVotingNotice { width: 340px; position: 0px 410px 0px; padding: 16px; flow-children: down; background-color: rgba(20,20,20,0.90); background-image: url("s2r://panorama/images/backgrounds/bluedots_large_png.vtex"); background-size: 360px 360px; background-img-opacity: 0.04; z-index: 1; }
.CaorenNoticeTitle { width: 100%; color: #ccccccff; font-family: Stratum2, "Arial Unicode MS"; font-weight: bold; font-size: 20px; margin-bottom: 8px; }
.CaorenNoticeQuestion { width: 100%; color: #ccccccff; font-size: 18px; margin-bottom: 8px; }
.CaorenNoticeStatus { width: 100%; color: #ccccccff; font-size: 16px; margin-bottom: 8px; }
.CaorenNoticeDetail { width: 100%; color: #ccccccff; font-size: 14px; margin-top: 4px; }
.CaorenVotingNotice.VoteWon #notice_status { color: #0F9D58; }
#vote_page { z-index: 5; }
.CaorenVoteOption { width: 100%; font-size: 20px; color: #ccccccff; vertical-align: center; }
.MyVote { background-color: #82d7ff1a; }

.CaorenNoticeOptions { width: 100%; font-size: 16px; color: #eeeeeeff; margin-bottom: 8px; white-space: normal; }
.CaorenVoteRow { width: 100%; min-height: 80px; margin: 0px; padding: 16px; border-bottom: 1px solid #ffffff33; flow-children: none; }
.CaorenVoteRow:hover { background-color: #ffffff22; }
.CaorenVoteRow.NotVoteable:hover { background-color: #ffffff00; }
.CaorenVoteRow.MyVote, .CaorenVoteRow.MyVote:hover { background-color: #82d7ff1a; }

/* 个人悬停声音分档，0% 保持无声；原生素材不写入资源包。 */
