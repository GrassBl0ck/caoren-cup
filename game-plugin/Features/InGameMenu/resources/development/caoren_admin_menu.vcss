/* 仅显式开启开发控件时加入 VPK。正式资源不包含此滑轨及调节样式。
   轨道/进度/滑块的尺寸、颜色来自 CS2 csgostyles.vcss_c 的 HorizontalSlider。
   用透明按钮命中区接收位置点击，不支持按住拖动。 */
.CaorenDevDescription { width: 45%; }
.CaorenDevSliderControl { width: 380px; height: 48px; horizontal-align: right; vertical-align: center; flow-children: right; }
.CaorenDevSlider { width: 300px; height: 32px; vertical-align: center; }
.CaorenDevSliderRail { width: 100%; height: 8px; vertical-align: center; background-color: #cccccc20; }
.CaorenDevSliderProgress { width: 10%; height: 8px; vertical-align: center; background-color: #cccccc80; }
.CaorenDevSliderSegments { width: 100%; height: 100%; flow-children: right; z-index: 3; }
.CaorenDevSliderSegment { width: fill-parent-flow(1); height: 100%; background-color: none; }
.CaorenDevSliderSegment:active { sound: "UIPanorama.submenu_select"; }
.CaorenDevSliderThumb { width: 16px; height: 12px; border-radius: 2px; background-color: #ccccccff; vertical-align: center; transform: translateX(28.4px); z-index: 4; }
.CaorenDevSliderValue { width: 64px; margin-left: 16px; text-align: right; vertical-align: center; color: #ccccccff; font-size: 20px; }
.CaorenSettings.DevTransparency0 { background-color: rgba(20,20,20,1.00); }
.DevTransparency0 #dev_slider_thumb { transform: translateX(0.0px); }
.DevTransparency0 #dev_slider_progress { width: 0%; }
.CaorenSettings.DevTransparency5 { background-color: rgba(20,20,20,0.95); }
.DevTransparency5 #dev_slider_thumb { transform: translateX(14.2px); }
.DevTransparency5 #dev_slider_progress { width: 5%; }
