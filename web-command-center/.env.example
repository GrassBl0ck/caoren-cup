# Provided to the process by your deployment environment; this application does not auto-load .env.
NODE_ENV=production
TRUST_PROXY=loopback

# Dedicated NetEase mailbox SMTP (163 example; use smtp.126.com for a 126 mailbox).
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Mail client authorization code, not the website login password. Never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# Public Minecraft connection information. No remote controls or online-status claims.
# Player-facing host and port, e.g. mc.example.org:25565. Leave empty to disable.
MC_SERVER_ADDRESS=
MC_SERVER_VERSION=26.3

# Optional Linux per-match CS2 service. Configure these together after setting up the systemd instance.
CAOREN_FORMAL_UNIT_PREFIX=
CAOREN_FORMAL_LAUNCH_ROOT=
CAOREN_FORMAL_DEMO_ROOT=
CAOREN_FORMAL_ARCHIVE_ROOT=

# HTTPS origin for Steam account binding. Configure the local Mihomo proxy if needed.
STEAM_BINDING_ORIGIN=
STEAM_BINDING_PROXY_URL=
# Optional path to a private JSON file with an adminEmails array.
CAOREN_ROOM_ADMIN_CONFIG=
# Legacy identity-ID allowlist for installations without an admin email file.
CAOREN_ROOM_ADMIN_IDENTITY_IDS=

# Optional path to the MSI served on the website; default: public/downloads/caotai-cup-setup.msi
CAOTAI_INSTALLER_PATH=

# Absolute path shared with the CS2 game/csgo/avatars directory.
CAOTAI_CS_AVATAR_DIR=

# Existing production configuration and secrets must be retained separately.
# Do not replace existing process environment with this incomplete example.
