# Provided to the process by your deployment environment; this application does not auto-load .env.
NODE_ENV=production
TRUST_PROXY=loopback

# Dedicated NetEase mailbox SMTP (163 example; use smtp.126.com for a 126 mailbox).
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Mail client authorization code, not the website login password. Never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# Public Minecraft connection information. No remote controls or online-status claims.
MC_SERVER_ADDRESS=123.206.213.166:25565
MC_SERVER_VERSION=26.3

# Existing production configuration and secrets must be retained separately.
# Do not replace existing process environment with this incomplete example.
